// Helper function to generate jitter for transparent pixels using Halton sequences


void main(void)
{
    // Compute pixel coordinates
    ivec2 pix  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(framebuffer);
    int index  = pix.y * size.x + pix.x;

    // Skip invalid or already converged pixels
    if (index >= size.x * size.y || pixelConverged[index]) {
        return;
    }

    // Generate jitter for sampling
    vec2 jitter;
    float frameSeed = float(sampleCount[index]);
    if (!transparent)
    {
        jitter = vec2(
            gold_noise(vec2(pix), frameSeed),
            gold_noise(vec2(pix) + vec2(11.31), frameSeed)
        );
    }
    else
    {
        int sampleIndex = int(frameSeed) % NUM_SAMPLES;
        jitter = vec2(halton2[sampleIndex], halton3[sampleIndex]);
    }

    // Jittered position in NDC
    vec2 pos = (vec2(pix) + jitter) / (vec2(size) - 0.5);
    pos      = 2.0 * pos - vec2(1.0);

    // Convert to world coordinates
    vec4 worldPos = vec4(pos.x, pos.y, 1.0, 1.0);
    worldPos      = persp_inverse * worldPos;
    worldPos     /= worldPos.w;
    worldPos.w    = 0.0;
    worldPos      = normalize(worldPos);

    // Compute ray origin and direction
    vec4 eye = mat_inverse * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 dir = normalize(mat_inverse * worldPos);

    // Trace the ray
    vec4 newSampleColor = trace(eye, dir);

    //  Force background rays to return black if no hit
    if (newSampleColor.a == 0.0 || any(lessThan(newSampleColor.rgb, vec3(0.0)))) {
        newSampleColor.rgb = vec3(0.0);
    }

    // Handle invalid values (NaN, INF)
    const float BIG_THRESHOLD = 1e10;
    if (any(greaterThan(abs(newSampleColor), vec4(BIG_THRESHOLD))) || any(isnan(newSampleColor.rgb)))
    {
        newSampleColor = vec4(0.0, 0.0, 0.0, 1.0);
    }

    // Retrieve previous accumulations
    vec4 oldData           = accumData[index];
    vec3 oldAverage        = oldData.rgb;
    float oldSquareAverage = oldData.a;
    uint oldCount          = sampleCount[index];

    // Compute updated averages
    float newCount         = float(oldCount + 1u);
    vec3 newAverage        = (oldAverage * float(oldCount) + newSampleColor.rgb) / newCount;
    float newSquareAverage = (oldSquareAverage * float(oldCount) + dot(newSampleColor.rgb, newSampleColor.rgb)) / newCount;

    // Compute variance and standard deviation
    vec3 variance = max(vec3(newSquareAverage) - (newAverage * newAverage), vec3(0.0));
    vec3 stddev   = sqrt(variance);

    //  Lower threshold for near-zero colors to help background converge
    vec3 relativeThreshold = max(0.05 * abs(newAverage), vec3(0.0001));

    //  Convergence check for near-zero background
    bool hasConverged = all(lessThan(stddev, relativeThreshold)) ||
                        all(lessThan(abs(newAverage), vec3(1e-6)));

    // Store the computed color
    //vec4 outputColor = hasConverged ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(newAverage, 1.0);
    vec4 outputColor = hasConverged ? vec4(newAverage, 1.0) : vec4(newAverage, 1.0);

    imageStore(framebuffer, pix, outputColor);

    // Update accumulations
    accumData[index]   = vec4(newAverage, newSquareAverage);
    sampleCount[index] = oldCount + 1u;

    //  Mark pixel as converged
    if (hasConverged)
    {
        pixelConverged[index] = true;
    }
}


