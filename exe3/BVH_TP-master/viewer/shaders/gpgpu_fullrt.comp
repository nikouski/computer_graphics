vec4 trace(vec4 origin, vec4 dir)
{
    const int MAX_BOUNCES = 10;
    trace_state_t stack[MAX_BOUNCES + 1];
    int sp = 0; // Stack pointer

    vec4 accumulatedColor = vec4(0.0); // Final accumulated color
    vec4 indirectLighting = vec4(0.0); // Tracks indirect illumination

    // Forward Tracing
    for (int i = 0; i < MAX_BOUNCES; i++) {
        hitinfo_t hl;
        if (!firstIntersection(origin, dir, hl)) {
            break; // No intersection, terminate
        }

        vec4 hitPoint, normal, localColor;
        getLocal(origin, dir, hl, localColor, hitPoint, normal);

        // Store intersection details
        stack[sp].origin = origin;
        stack[sp].dir = dir;
        stack[sp].color = localColor;
        stack[sp].hit = hitPoint;
        stack[sp].N = normal;
        sp++;

        // Compute reflected direction for the next ray
        dir = normalize(reflect(dir, normal));
        origin = hitPoint + 0.001 * normal; // Offset origin to avoid self-intersection
    }

    float energyLoss = 0.95; // Retain 95% energy per bounce
    float reflectionFactor = 1.0;
    // Backward Color Computation
    for (int i = sp - 1; i >= 0; i--) {
        vec4 localColor = stack[i].color;
        vec4 hitPoint = stack[i].hit;
        vec4 normal = stack[i].N;
        vec4 viewDir = -stack[i].dir;

        // Local Illumination using shadow rays
        vec4 localIllum = directIllumination(localColor, hitPoint, normal, viewDir);

        // Combine with indirect illumination using Fresnel coefficients
        float fresnel = fresnel2(dot(viewDir, normal), eta, etaImg);
        indirectLighting *= fresnel; // Scale previous indirect light
        indirectLighting += localIllum;

        reflectionFactor *= energyLoss; // Reduce reflection contribution for each bounce
        indirectLighting *= reflectionFactor;
        
        accumulatedColor = localIllum + indirectLighting;
    }
    accumulatedColor = clamp(accumulatedColor, 0.0, 1.0);
    
    return accumulatedColor;
}

